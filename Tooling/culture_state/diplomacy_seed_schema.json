{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project Crown Diplomacy Seed Entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source",
    "target",
    "relationship_type",
    "reason",
    "supporting_basis",
    "strength_priority",
    "rollout_wave",
    "notes"
  ],
  "properties": {
    "source": { "type": "string" },
    "target": { "type": "string" },
    "relationship_type": {
      "type": "string",
      "enum": ["rival", "friend", "historical_friend", "historical_rival", "opinion_modifier", "alliance_hint", "threat_hint"]
    },
    "reason": { "type": "string" },
    "supporting_basis": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["contested province", "core", "claim", "trade", "religion", "geography", "history", "formable clash", "balance"]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "strength_priority": { "type": "string", "enum": ["low", "medium", "high"] },
    "rollout_wave": { "type": "string" },
    "notes": { "type": "string" }
  }
}
